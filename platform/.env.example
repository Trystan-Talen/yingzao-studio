HOST=127.0.0.1
PORT=4310
PUBLIC_ORIGIN=http://127.0.0.1:5174
# Optional: defaults are var/app.sqlite + var/media (demo uses separate paths).
# DATABASE_PATH=var/app.sqlite
# STORAGE_DIR=var/media
# DNS（域名解析）默认 system（系统）；代理返回虚拟地址时，可显式改为 public-doh（公共加密解析）。
# 公共模式只使用固定 Google（谷歌）端点解析 IPv4（第四版网络地址）；仍拒绝私网及保留地址。
MEDIA_DNS_MODE=system
# 媒体下载总时限，覆盖解析、跳转及完整传输；单位毫秒，允许 1000 至 600000。
# 低带宽环境可显式设为 300000（5 分钟），默认保持 120000（2 分钟）。
MEDIA_DOWNLOAD_TIMEOUT_MS=120000
DEMO_MODE=false
# Required in production: independent random values, at least 32 bytes each.
# Existing installations: do not replace encryption keys without migrating encrypted records.
SESSION_SECRET=
ENCRYPTION_KEY=
# Optional, installation-level credentials; UI settings are workspace-specific.
OPENAI_API_KEY=
# Optional image gateway: only 1024x1024 text-to-image, low quality, one image.
# Leave empty to retain the official OpenAI provider and existing operations.
IMAGE_API_BASE_URL=
IMAGE_MODEL=gpt-image-2
# Seedream（豆包生图）可设为 doubao-seedream-5.0-lite，自动使用单张 2048×2048；不会发出旧模型的质量参数。
DIFY_API_KEY=
DIFY_API_BASE_URL=https://api.dify.ai/v1
SEEDANCE_API_KEY=
SEEDANCE_TASK_BASE_URL=https://xingyunyinli.com/doubao/api/v3/contents/generations/tasks
SEEDANCE_MODEL=doubao-seedance-2.0
FAL_KEY=
FLYELEP_SECRET_KEY=
# Real Stripe Checkout requires both values; demo mode accepts only sk_test_.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Application exports only; defaults to off. Demo workspaces are exempt.
EXPORT_WATERMARK_MODE=off
EXPORT_WATERMARK_TEXT=映造 Studio
EXPORT_WATERMARK_OPACITY=0.28
# Google OIDC is disabled by default. Register the fixed callback:
# <PUBLIC_ORIGIN>/api/v1/auth/google/callback
GOOGLE_OIDC_ENABLED=false
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# SMTP: explicitly enable after configuring your authorized sender; no historical backfill.
# SMTP acceptance is not a guarantee of mailbox delivery. See OPERATIONS-MAIL.md.
SMTP_ENABLED=false
SMTP_HOST=
SMTP_PORT=587
SMTP_TLS_MODE=starttls
SMTP_FROM=
SMTP_FROM_NAME=映造 Studio
SMTP_USER=
SMTP_PASSWORD=
# 密码恢复另行显式开启；必须同时配置已授权的邮件发送服务，默认关闭。
PASSWORD_RECOVERY_ENABLED=false
# 手机短信及微信网站登录，默认关闭；仅在明确授权外呼并配置正式签名/模板后开启。
SMS_AUTH_ENABLED=false
SMS_ALIYUN_ACCESS_KEY_ID=
SMS_ALIYUN_ACCESS_KEY_SECRET=
SMS_ALIYUN_SECURITY_TOKEN=
SMS_SIGN_NAME=
SMS_TEMPLATE_CODE=
SMS_CODE_VARIABLE=code
WECHAT_AUTH_ENABLED=false
WECHAT_APP_ID=
WECHAT_APP_SECRET=

# Optional public video share parsing; provider calls are billed separately.
TIKHUB_API_KEY=

# 本实例公开客服资料；留空显示未配置，不继承原站联系方式。
# 链接仅接受不含账户凭据的 HTTPS（加密网页协议）地址；二维码由浏览器在点击后加载。
SUPPORT_PHONE=
SUPPORT_HOURS=
SUPPORT_WECHAT_QR_URL=
SUPPORT_FEEDBACK_URL=
SUPPORT_GUIDE_URL=
