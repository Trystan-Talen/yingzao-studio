{
  "name": "yingzao-studio",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.25.0",
  "engines": {
    "node": ">=22.12 <23 || >=24"
  },
  "scripts": {
    "dev": "tsx scripts/dev.ts",
    "dev:web": "vite --host 127.0.0.1",
    "dev:api": "tsx watch src/server/main.ts",
    "worker": "tsx src/worker/main.ts",
    "migrate": "tsx scripts/migrate.ts",
    "seed-demo": "tsx scripts/seed-demo.ts",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src scripts tests",
    "format": "prettier --write src scripts tests *.ts *.json",
    "format:check": "prettier --check src scripts tests *.ts *.json",
    "test": "vitest run",
    "test:e2e": "tsx scripts/e2e.ts",
    "build": "vite build && tsup src/server/main.ts src/worker/main.ts --format esm --platform node --target node22 --out-dir dist/runtime --sourcemap --clean",
    "start": "node dist/runtime/server/main.js",
    "start:worker": "node dist/runtime/worker/main.js",
    "backup": "tsx scripts/backup.ts",
    "health": "tsx scripts/health.ts",
    "verify:runtime": "tsx scripts/verify-runtime.ts",
    "restore": "tsx scripts/restore.ts",
    "create-redemption": "tsx scripts/create-redemption.ts",
    "dev:demo": "DEMO_MODE=true tsx scripts/dev.ts",
    "seed-demo-assets": "tsx scripts/seed-demo-assets.ts"
  },
  "dependencies": {
    "@fastify/cookie": "11.1.3",
    "@fastify/multipart": "10.1.3",
    "@fastify/rate-limit": "11.2.1",
    "@fastify/static": "10.1.6",
    "@fastify/swagger": "9.9.2",
    "@fastify/swagger-ui": "6.1.2",
    "@radix-ui/react-dialog": "1.3.1",
    "@radix-ui/react-dropdown-menu": "2.2.1",
    "@radix-ui/react-tabs": "1.2.1",
    "@tanstack/react-query": "5.104.2",
    "better-sqlite3": "13.0.3",
    "dotenv": "17.2.3",
    "drizzle-orm": "0.45.4",
    "exceljs": "4.4.0",
    "fabric": "7.4.0",
    "fastify": "5.12.7",
    "fastify-type-provider-zod": "7.0.0",
    "file-type": "22.1.1",
    "jose": "6.2.12",
    "jszip": "3.10.2",
    "lucide-react": "1.56.0",
    "mammoth": "1.13.0",
    "nodemailer": "10.1.1",
    "pdf-parse": "2.4.5",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-router-dom": "7.18.4",
    "sharp": "0.35.5",
    "stripe": "23.0.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@types/better-sqlite3": "9.6.0",
    "@types/node": "22.20.5",
    "@types/nodemailer": "8.0.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "5.2.0",
    "eslint": "9.39.5",
    "prettier": "3.9.10",
    "tsup": "8.5.1",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "typescript-eslint": "8.71.2",
    "vite": "7.3.7",
    "vitest": "5.0.4"
  }
}
